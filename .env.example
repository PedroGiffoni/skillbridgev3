# Somente backend. Não cole esta chave no chat ou em variáveis VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=
# Ative somente após confirmar modelo e cota gratuita no projeto AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
# Modelo de voz separado. Confirme a cota gratuita no mesmo projeto antes de ativar.
GEMINI_TTS_MODEL=
GEMINI_TTS_FREE_TIER_CONFIRMED=false
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_REQUESTS_PER_MINUTE=5
# Use false para voltar a gerar quatro semanas mantendo a leitura do histórico V3.
STUDY_PLAN_V3_ENABLED=true
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Login. Use segredo aleatório com ao menos 32 caracteres.
AUTH_OTP_SECRET=
# Padrão backend/data/skillbridge.sqlite3. Configure caminho persistente na hospedagem.
# AUTH_DB_PATH=
AUTH_COOKIE_SECURE=false
# Contas com e-mail verificado autorizadas a ver métricas agregadas.
AUTH_ADMIN_EMAILS=[]
AUTH_GOOGLE_CLIENT_ID=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_SSL=false
